<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:maxWidth="270dp"
        android:background="@drawable/bg_message_assistant"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp">

        <TextView
            android:maxWidth="250dp"
            android:fontFamily="@font/geistmedium"
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:lineSpacingExtra="3sp"
            tools:text="Я рядом. Расскажи, что тебя беспокоит." />

        <TextView
            android:fontFamily="@font/geistmedium"
            android:id="@+id/tvMessageStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8A8A8A"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="…"
            tools:visibility="visible" />
        <TextView
            android:id="@+id/message_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="01.01.2025 12:00"
            android:fontFamily="@font/geistsemibold"
            android:textSize="10sp"
            android:textColor="#5C5A5A" />
    </LinearLayout>
</FrameLayout>