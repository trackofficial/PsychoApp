<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<!--📖-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">

        <TextView
            android:id="@+id/icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:fontFamily="@font/coolvetica"
            android:text="@string/psycho"
            android:textSize="32sp"
            android:includeFontPadding="false"/>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/logout_button_bg"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textAllCaps="false"
            android:text="@string/logout"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:fontFamily="@font/geistmedium" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/yournotesbutton"
        android:clickable="true"
        android:layout_marginTop="40dp"
        android:padding="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:orientation="vertical"
        android:background="@drawable/round_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️"
            android:textSize="24dp"/>
        <TextView
            android:layout_marginTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yournotes"
            android:textSize="20dp"
            android:textColor="@color/fullblack"
            android:fontFamily="@font/geistsemibold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/noteopr"
            android:fontFamily="@font/geistmedium"
            android:textSize="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/youraiassisbutton"
        android:clickable="true"
        android:layout_marginTop="12dp"
        android:padding="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:orientation="vertical"
        android:background="@drawable/round_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖"
            android:textSize="24dp"/>
        <TextView
            android:layout_marginTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aiassist"
            android:textSize="20dp"
            android:textColor="@color/fullblack"
            android:fontFamily="@font/geistsemibold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aiopr"
            android:fontFamily="@font/geistmedium"
            android:textSize="10dp"/>
    </LinearLayout>
</LinearLayout>