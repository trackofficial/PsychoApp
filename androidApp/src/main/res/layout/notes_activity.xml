<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header -->
    <TextView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/psycho"
        android:textColor="@color/fullblack"
        android:fontFamily="@font/coolvetica"
        android:textSize="32sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="34dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yournotes"
        android:textColor="#8A99AA"
        android:textSize="14sp"
        android:fontFamily="@font/geistmedium"
        android:layout_marginStart="22dp"
        android:layout_marginTop="4dp" />

    <!-- Notes container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notes_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp" />

        <!-- Empty state -->
        <View
            android:id="@+id/empty_view"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginBottom="50dp"
            android:background="@drawable/without_notes_image"
            android:visibility="gone" />

        <!-- Add note button -->
        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/blue_round_button">

            <View
                android:id="@+id/btn_add_note"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                android:background="@drawable/file_icon"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

    </FrameLayout>

</LinearLayout>