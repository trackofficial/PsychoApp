<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:fontFamily="@font/coolvetica"
            android:text="Psycho"
            android:textSize="32dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"/>
        <LinearLayout
            android:layout_marginBottom="24dp"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <EditText
                android:textSize="15dp"
                android:fontFamily="@font/geistmonomedium"
                android:textCursorDrawable="@color/black"
                android:hint="@string/login"
                android:textColor="@color/black"
                android:textColorHint="@color/black40"
                android:paddingLeft="16dp"
                android:id="@+id/login_space"
                android:layout_height="50dp"
                android:layout_width="match_parent"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:background="@drawable/round_block"/>
            <EditText
                android:textSize="15dp"
                android:inputType="textPassword"
                android:fontFamily="@font/geistmonomedium"
                android:textCursorDrawable="@color/black"
                android:hint="@string/password"
                android:textColor="@color/black"
                android:textColorHint="@color/black40"
                android:paddingLeft="16dp"
                android:layout_marginTop="10dp"
                android:id="@+id/password_space"
                android:layout_height="50dp"
                android:layout_width="match_parent"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:background="@drawable/round_block"/>
            <Button
                android:fontFamily="@font/geistmonomedium"
                android:background="@null"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:textAllCaps="false"
                android:id="@+id/btn_go_to_reg"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="Зарегистрироваться"
                android:stateListAnimator="@null"
                android:textSize="12sp" />
        </LinearLayout>
        <Button
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="bottom"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_marginRight="60dp"
            android:layout_marginLeft="60dp"
            android:layout_height="60dp"
            android:background="@drawable/black_round_button"
            android:text="@string/login"
            android:id="@+id/login_btn"
            android:textColor="@color/background_color"
            android:fontFamily="@font/geistmonomedium"/>
    </FrameLayout>