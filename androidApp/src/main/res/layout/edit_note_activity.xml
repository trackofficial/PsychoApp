<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Note title -->
        <EditText
            android:id="@+id/edit_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:hint="@string/title"
            android:textColor="@color/fullblack"
            android:textColorHint="#A0ACBA"
            android:textSize="22sp"
            android:fontFamily="@font/geistsemibold"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:gravity="top|start"
            android:background="@null"
            android:padding="0dp" />

        <!-- Note text -->
        <EditText
            android:id="@+id/edit_note_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp"
            android:hint="@string/descript"
            android:textColor="@color/fullblack"
            android:textColorHint="#A0ACBA"
            android:fontFamily="@font/geistmedium"
            android:textSize="16sp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:background="@null"
            android:padding="0dp"
            android:lineSpacingExtra="4dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <!-- Save -->
            <Button
                android:id="@+id/btn_save_note"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/save"
                android:textColor="@color/fullblack"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="@font/geistsemibold"
                android:background="@drawable/blue_round_button"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:gravity="center" />

            <!-- Delete -->
            <Button
                android:id="@+id/btn_delete_note"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/delete"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="@font/geistsemibold"
                android:background="@drawable/red_round_button"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>