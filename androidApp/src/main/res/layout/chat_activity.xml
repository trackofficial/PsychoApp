<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#FFEBEE"
        android:textColor="#B71C1C"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Нет соединения с интернетом"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_chat_message_assistant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/writetext"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:fontFamily="@font/geistmedium"
            android:minLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:background="@drawable/round_block"
            android:textSize="15sp"
            android:textColor="#000000"
            android:textColorHint="#8A8A8A"/>

        <FrameLayout
            android:background="@drawable/black_round_button_pre"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp">
            <View
                android:id="@+id/btnSend"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/icon_arch"/>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:fontFamily="@font/geistregular"
        android:id="@+id/tvDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:text="@string/warning"
        android:textColor="#8A8A8A"
        android:textSize="9sp" />
</LinearLayout>