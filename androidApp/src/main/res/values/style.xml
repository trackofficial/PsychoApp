<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_color</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/icon_app_psycho_svg</item>
        <item name="postSplashScreenTheme">@style/Theme.PsychoApp</item>
    </style>

    <style name="Theme.PsychoApp" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/fullblack</item>
        <item name="android:navigationBarColor">@color/fullblack</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorControlActivated">@color/background_color</item>
        <item name="colorControlNormal">@color/black40</item>
        <item name="android:windowBackground">@color/background_color</item>
    </style>
</resources>
