<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Отмечен -->
    <item android:state_checked="true">
        <layer-list>

            <!-- Рамка -->
            <item>
                <shape android:shape="rectangle">
                    <size
                        android:width="22dp"
                        android:height="22dp"/>
                    <corners android:radius="4dp"/>
                    <solid android:color="@android:color/transparent"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="#347FC4"/>
                </shape>
            </item>

            <!-- Галочка -->
            <item
                android:drawable="@drawable/ic_check_blue"
                android:top="2dp"
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"/>

        </layer-list>
    </item>

    <!-- Не отмечен -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="22dp"
                android:height="22dp"/>
            <corners android:radius="4dp"/>
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="1.5dp"
                android:color="#8291A3"/>
        </shape>
    </item>

</selector>
