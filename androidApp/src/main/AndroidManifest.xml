<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/logo_app_psycho_svg"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_app_psycho_svg"
        android:theme="@style/Theme.App.Starting">

        <!-- АКТИВНОСТИ -->
        <activity
            android:exported="true"
            android:name=".ui.auth.LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.RegistrationActivity"
            android:theme="@style/Theme.PsychoApp" />
        <activity android:name=".ui.main.MainActivity"
            android:theme="@style/Theme.PsychoApp"/>
        <activity android:name=".ui.notes.AddNoteActivity" />
        <activity android:name=".ui.notes.NotesActivity" />
        <activity android:name=".ui.notes.EditNoteActivity" />
        <activity android:name=".ui.chat.ChatActivity" />

    </application>
</manifest>
